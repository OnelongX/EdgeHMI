{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgehmi.local/schema/config.schema.json",
  "title": "EdgeHMI Industrial Configuration Schema",
  "type": "object",
  "required": ["version", "device", "modbus", "rules", "pages"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "device": {
      "type": "object",
      "required": ["name", "width", "height"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 48 },
        "width": { "type": "integer", "minimum": 128, "maximum": 1280 },
        "height": { "type": "integer", "minimum": 64, "maximum": 800 },
        "theme": { "type": "string", "enum": ["dark", "light"] },
        "poll_interval_ms": { "type": "integer", "minimum": 50, "maximum": 10000 },
        "watchdog_timeout_s": { "type": "integer", "minimum": 3, "maximum": 60 },
        "idle_dim_s": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "idle_brightness_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "engineer_pin": { "type": "string", "pattern": "^[0-9]{4,8}$" },
        "api_token": { "type": "string", "maxLength": 64 }
      }
    },
    "modbus": {
      "type": "object",
      "required": ["baudrate", "points"],
      "properties": {
        "port": { "type": "integer", "minimum": 0, "maximum": 2 },
        "baudrate": { "type": "integer", "enum": [4800, 9600, 19200, 38400, 57600, 115200] },
        "tx_pin": { "type": "integer", "minimum": 0, "maximum": 48 },
        "rx_pin": { "type": "integer", "minimum": 0, "maximum": 48 },
        "de_pin": { "type": "integer", "minimum": -1, "maximum": 48 },
        "timeout_ms": { "type": "integer", "minimum": 50, "maximum": 5000 },
        "points": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["tag", "slave", "fc", "addr", "type"],
            "properties": {
              "tag": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,31}$" },
              "slave": { "type": "integer", "minimum": 1, "maximum": 247 },
              "fc": { "type": "integer", "enum": [1, 2, 3, 4, 5, 6, 16] },
              "addr": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "type": { "type": "string", "enum": ["bool", "u16", "i16", "u32", "f32"] },
              "byte_order": { "type": "string", "enum": ["ABCD", "CDAB", "BADC", "DCBA"] },
              "scale": { "type": "number" },
              "offset": { "type": "number" },
              "unit": { "type": "string", "maxLength": 16 },
              "rw": { "type": "string", "enum": ["r", "w", "rw"] },
              "default": { "type": "number" },
              "retentive": { "type": "boolean" }
            }
          }
        }
      }
    },
    "modbus_tcp": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string", "maxLength": 64 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "timeout_ms": { "type": "integer", "minimum": 50, "maximum": 5000 },
        "server_enabled": { "type": "boolean" },
        "server_port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "local_io": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["tag", "pin", "mode"],
        "properties": {
          "tag": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,31}$" },
          "pin": { "type": "integer", "minimum": 0, "maximum": 48 },
          "mode": { "type": "string", "enum": ["di", "do", "adc", "pwm"] },
          "active_low": { "type": "boolean" },
          "scale": { "type": "number" },
          "offset": { "type": "number" },
          "unit": { "type": "string", "maxLength": 16 },
          "default": { "type": "number" },
          "retentive": { "type": "boolean" }
        }
      }
    },
    "can_bus": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "bitrate": { "type": "integer", "enum": [125000, 250000, 500000] },
        "tx_pin": { "type": "integer", "minimum": 0, "maximum": 48 },
        "rx_pin": { "type": "integer", "minimum": 0, "maximum": 48 },
        "signals": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["tag", "can_id", "start_bit", "bit_len"],
            "properties": {
              "tag": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,31}$" },
              "can_id": { "type": "integer", "minimum": 0, "maximum": 536870911 },
              "ext_id": { "type": "boolean" },
              "start_bit": { "type": "integer", "minimum": 0, "maximum": 63 },
              "bit_len": { "type": "integer", "minimum": 1, "maximum": 32 },
              "signed": { "type": "boolean" },
              "big_endian": { "type": "boolean" },
              "scale": { "type": "number" },
              "offset": { "type": "number" },
              "unit": { "type": "string", "maxLength": 16 },
              "default": { "type": "number" }
            }
          }
        }
      }
    },
    "calc_tags": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["tag", "op", "src_a"],
        "properties": {
          "tag": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,31}$" },
          "op": { "type": "string", "enum": ["add", "sub", "mul", "div", "avg", "integrate"] },
          "src_a": { "type": "string" },
          "src_b": { "type": "string" },
          "scale": { "type": "number" },
          "offset": { "type": "number" },
          "unit": { "type": "string", "maxLength": 16 }
        }
      }
    },
    "cloud": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mqtt_uri": { "type": "string", "maxLength": 96 },
        "client_id": { "type": "string", "maxLength": 48 },
        "username": { "type": "string", "maxLength": 32 },
        "password": { "type": "string", "maxLength": 48 },
        "topic_prefix": { "type": "string", "maxLength": 48 },
        "publish_interval_ms": { "type": "integer", "minimum": 500, "maximum": 60000 }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "wifi_ssid": { "type": "string", "maxLength": 32 },
        "wifi_password": { "type": "string", "maxLength": 64 },
        "ap_fallback": { "type": "boolean" },
        "failover_policy": { "type": "string", "enum": ["wifi_only", "cellular_only", "wifi_primary", "cellular_primary"] },
        "modem_4g_enabled": { "type": "boolean" },
        "modem_tx_pin": { "type": "integer", "minimum": -1, "maximum": 48 },
        "modem_rx_pin": { "type": "integer", "minimum": -1, "maximum": 48 },
        "cellular": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "generation": { "type": "string", "enum": ["auto", "4g", "5g", "5g_redcap"] },
            "interface": { "type": "string", "enum": ["uart_ppp", "usb_ecm"] },
            "apn": { "type": "string", "maxLength": 48 },
            "apn_user": { "type": "string", "maxLength": 32 },
            "apn_pass": { "type": "string", "maxLength": 32 },
            "sim_pin": { "type": "string", "maxLength": 12 },
            "uart_port": { "type": "integer", "minimum": 0, "maximum": 2 },
            "baudrate": { "type": "integer", "enum": [115200, 230400, 460800, 921600, 1500000, 3000000] },
            "tx_pin": { "type": "integer", "minimum": -1, "maximum": 48 },
            "rx_pin": { "type": "integer", "minimum": -1, "maximum": 48 },
            "rts_pin": { "type": "integer", "minimum": -1, "maximum": 48 },
            "cts_pin": { "type": "integer", "minimum": -1, "maximum": 48 },
            "pwrkey_pin": { "type": "integer", "minimum": -1, "maximum": 48 },
            "reset_pin": { "type": "integer", "minimum": -1, "maximum": 48 }
          }
        }
      }
    },
    "recipes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "items"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 32 },
          "name": { "type": "string", "maxLength": 48 },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "required": ["tag", "value"],
              "properties": {
                "tag": { "type": "string" },
                "value": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "schedules": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 32 },
          "enabled": { "type": "boolean" },
          "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "interval_s": { "type": "integer", "minimum": 1 },
          "days_mask": { "type": "integer", "minimum": 1, "maximum": 127 },
          "recipe_id": { "type": "string" },
          "target_tag": { "type": "string" },
          "value": { "type": "number" }
        }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "when", "then"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 32 },
          "desc": { "type": "string", "maxLength": 96 },
          "enabled": { "type": "boolean" },
          "enforce": { "type": "boolean" },
          "when": {
            "type": "object",
            "properties": {
              "tag": { "type": "string" },
              "op": { "type": "string", "enum": [">", ">=", "<", "<=", "==", "!="] },
              "value": { "type": "number" },
              "hysteresis": { "type": "number", "minimum": 0 },
              "debounce_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
              "on_comm_loss": { "type": "boolean" },
              "all": { "type": "array", "maxItems": 4 },
              "any": { "type": "array", "maxItems": 4 }
            }
          },
          "then": {
            "type": "object",
            "required": ["action"],
            "properties": {
              "action": { "type": "string", "enum": ["set_tag", "alarm"] },
              "target_tag": { "type": "string" },
              "value": { "type": "number" },
              "level": { "type": "string", "enum": ["info", "warn", "critical"] },
              "message": { "type": "string", "maxLength": 96 }
            }
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "title", "widgets"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,24}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 48 },
          "widgets": {
            "type": "array",
            "maxItems": 48,
            "items": {
              "type": "object",
              "required": ["id", "type", "x", "y", "w", "h"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 32 },
                "type": {
                  "type": "string",
                  "enum": ["card", "label", "value", "gauge", "bar", "button", "switch", "badge", "chart", "slider", "spinbox", "alarm_list", "qrcode", "image", "dropdown", "led"]
                },
                "x": { "type": "integer", "minimum": 0 },
                "y": { "type": "integer", "minimum": 0 },
                "w": { "type": "integer", "minimum": 8 },
                "h": { "type": "integer", "minimum": 8 },
                "text": { "type": "string", "maxLength": 96 },
                "bind": { "type": "string" },
                "unit": { "type": "string", "maxLength": 16 },
                "min": { "type": "number" },
                "max": { "type": "number" },
                "step": { "type": "number", "exclusiveMinimum": 0 },
                "decimals": { "type": "integer", "minimum": 0, "maximum": 4 },
                "color": { "type": "string" },
                "src": { "type": "string", "maxLength": 96 },
                "write_value": { "type": "number" },
                "nav_page": { "type": "string" },
                "true_text": { "type": "string" },
                "false_text": { "type": "string" },
                "confirm": { "type": "boolean" },
                "confirm_text": { "type": "string", "maxLength": 96 },
                "pin_required": { "type": "boolean" },
                "color_rules": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "required": ["op", "value", "color"],
                    "properties": {
                      "op": { "type": "string", "enum": [">", ">=", "<", "<=", "==", "!="] },
                      "value": { "type": "number" },
                      "color": { "type": "string" }
                    }
                  }
                },
                "visible_when": {
                  "type": "object",
                  "required": ["tag", "op", "value"],
                  "properties": {
                    "tag": { "type": "string" },
                    "op": { "type": "string", "enum": [">", ">=", "<", "<=", "==", "!="] },
                    "value": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
